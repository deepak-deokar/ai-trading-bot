# Copy locally; supply your own development password. Never commit .env.
POSTGRES_USER=trading
POSTGRES_DB=trading
POSTGRES_PASSWORD=replace-with-local-password
# Percent-encode special characters in the URL password.
DATABASE_URL=postgresql+psycopg://trading:replace-with-local-password@localhost:5432/trading
CONFIG_FILE=config/development.yaml
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
# Required only for the optional containerized API (hostname db).
DOCKER_DATABASE_URL=postgresql+psycopg://trading:replace-with-local-password@db:5432/trading

# Optional DATA ONLY; use a manually generated Groww access token.
# GROWW_ACCESS_TOKEN=
